[Unit]
Description=GTT Node RTP calibration worker
After=network.target

[Service]
Type=simple
User=gtt-node
Group=gtt-node
WorkingDirectory=/opt/gtt-node/current/gateway
ExecStart=/usr/bin/node dist/cli.js rtp-worker --config /etc/gtt-node/production.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gtt-node
UMask=0077

[Install]
WantedBy=multi-user.target
