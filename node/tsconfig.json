{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "compat/**/*.ts",
    "services/**/*.ts",
    "migrated/**/*.ts",
    "shared/**/*.ts",
    "games/**/*.ts",
    "gateway/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ]
}
