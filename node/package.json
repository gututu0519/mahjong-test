{
  "name": "gtt-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "build": "tsc",
    "docs:build": "node tools/render-integration.mjs",
    "docs:check": "node tools/render-integration.mjs --check",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "init": "node dist/cli.js init",
    "gateway": "node dist/cli.js gateway",
    "admin": "node dist/cli.js admin",
    "buffalo": "node dist/cli.js buffalo",
    "rtp-worker": "node dist/cli.js rtp-worker",
    "service": "node dist/cli.js service",
    "platform": "node dist/cli.js platform",
    "sandbox-init": "node dist/cli.js sandbox-init",
    "package": "npm run build && node tools/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3"
  }
}
