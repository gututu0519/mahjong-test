[Unit]
Description=GTT Node platform and merchant administration
After=network.target gtt-node-buffalo.service
Wants=gtt-node-buffalo.service

[Service]
Type=simple
User=gtt-node
Group=gtt-node
WorkingDirectory=/opt/gtt-node/current/gateway
ExecStart=/usr/bin/node dist/cli.js admin --config /etc/gtt-node/production.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gtt-node
UMask=0077

[Install]
WantedBy=multi-user.target
