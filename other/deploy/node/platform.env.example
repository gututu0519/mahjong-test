# 平台应用部署模板：网关、管理后台和 RTP worker 共用一份。
# 这是示例文件，需替换占位值；生产安装到 /etc/gtt-node/platform.env，权限建议为 0600。
# 本机实际运行配置位于 gateway/instance/platform.env，真实配置不提交、不进入发布包。
# 运行环境：development 为开发环境，production 为生产环境。
NODE_ENV=production
# 平台结构配置文件路径。
GTT_CONFIG_FILE=/etc/gtt-node/production.json
# PostgreSQL 存储路由配置路径，连接凭据由本文件提供。
GTT_PG_CONFIG=/etc/gtt-node/postgres.json
# PostgreSQL 主机地址。
PGHOST=127.0.0.1
# PostgreSQL 端口；此处为部署示例，本机现有端口为 15432。
PGPORT=5432
# 目标数据库名称。
PGDATABASE=gtt_new_database
# 数据库连接账号。
PGUSER=gtt_application
# 数据库连接密码：替换占位值，不要提交真实密码。
PGPASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
# TLS 模式：disable 不启用，require 仅加密，verify-full 校验证书及主机名。
PGSSLMODE=disable
# 平台内部认证密钥：替换为至少 32 个字符的随机密钥。
GTT_INTERNAL_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# 网关监听地址，默认仅允许本机反向代理访问。
GATEWAY_HOST=127.0.0.1
# 网关监听端口。
GATEWAY_PORT=8110
# 管理后台监听地址。
ADMIN_HOST=127.0.0.1
# 管理后台监听端口，平台后台和商户后台共用此服务。
ADMIN_PORT=8112
# 游戏计算模式：remote 使用独立服务，embedded 为历史内嵌兼容模式。
GAME_SERVICES_MODE=remote
# 官网公开地址。
GTT_SITE_ORIGIN=https://www.example.com
# API 公开地址。
GTT_API_ORIGIN=https://api.example.com
# 游戏启动公开地址。
GTT_PLAY_ORIGIN=https://play.example.com
# 平台管理后台公开地址。
GTT_ADMIN_ORIGIN=https://admin.example.com
# 商户工作台公开地址。
GTT_MERCHANT_ORIGIN=https://merchant.example.com
# 客户端版本域名模板；保留 {release} 和 {game_id}，由运行时替换。
GTT_FRONTEND_ORIGIN_TEMPLATE=https://{release}-g{game_id}.play.example.com
