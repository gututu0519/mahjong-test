# 独立游戏计算服务的单个版本实例模板，不包含 PostgreSQL 或平台凭据。
# 生产安装到 /etc/gtt-node/games/<游戏代码>/<发布版本>.env。
# 游戏代码，必须与部署的游戏包一致。
GAME_ID=buffalo-win
# 发布版本号：替换占位值，新旧版本并行时分别使用各自的文件。
GAME_RELEASE=REPLACE_WITH_BUILD_ID
# 本实例使用的游戏规则配置文件绝对路径。
GAME_CONFIG=/opt/gtt-node/games/buffalo-win/REPLACE_WITH_BUILD_ID/config/game.json
# 计算服务监听地址，通常为回环或私网地址。
GAME_BIND=127.0.0.1
# 计算服务端口；同机并行的版本实例必须使用不同端口。
GAME_PORT=8211
# 本游戏内部认证密钥文件路径，密钥内容不直接写入 env。
GAME_SECRET_FILE=/etc/gtt-node/secrets/buffalo-win.key
