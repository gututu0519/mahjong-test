{
  "env_file": "/etc/gtt-node/platform.env",
  "environment": "production",
  "game_services_mode":"remote",
  "game_service_hosts":[],
  "frontend_releases_directory":"/var/lib/gtt-node/frontend-releases",
  "frontend_origin_template":"https://{release}-g{game_id}.play.example.com",
  "merchant_database": "/var/lib/gtt-node/merchants.sqlite3",
  "game_database": "/var/lib/gtt-node/gtt.sqlite3",
  "client_root": "/opt/gtt-node/gateway/current/resources/clients/buffalo-win",
  "public_origins": {
    "site": "https://www.example.com",
    "api": "https://api.example.com",
    "play": "https://play.example.com",
    "admin": "https://admin.example.com",
    "merchant": "https://merchant.example.com"
  },
  "trusted_proxy_ips": ["127.0.0.1", "::1"],
  "postgres_config": "/etc/gtt-node/postgres.json"
}
