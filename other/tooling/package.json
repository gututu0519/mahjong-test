{
  "name": "gtt-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "frontend:build": "node run.mjs build-frontend",
    "frontend:install": "node run.mjs install-frontend",
    "frontend:stage": "node run.mjs stage-frontend",
    "docs:build": "node run.mjs render-integration",
    "docs:check": "node run.mjs render-integration --check",
    "test": "node run.mjs test",
    "init": "node run.mjs cli init",
    "gateway": "node run.mjs start gateway",
    "games": "node run.mjs start games",
    "admin": "node run.mjs start admin",
    "buffalo": "node run.mjs cli buffalo",
    "rtp-worker": "node run.mjs start rtp-worker",
    "service": "node run.mjs cli service",
    "platform": "node run.mjs start platform",
    "sandbox-init": "node run.mjs cli sandbox-init",
    "package": "node run.mjs package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fflate": "0.8.2",
    "prettier": "3.9.10",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
