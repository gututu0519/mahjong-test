{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "../../games/*/backend/**/*.ts",
    "../../gateway/src/**/*.ts",
    "../../admin/backend/**/*.ts",
    "../shared/**/*.ts",
    "../tests/*.ts",
    "cli.ts"
  ]
}
