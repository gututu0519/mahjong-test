{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "GTT two CloudFront distributions: private S3 website and protected ALB business origins. No DNS changes.",
  "Parameters": {
    "FoundationStackName": {
      "Type": "String",
      "Default": "gtt-foundation"
    },
    "DomainName": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]+\\.[a-z]{2,}",
      "Default": "gttgames.com"
    },
    "PriceClass": {
      "Type": "String",
      "AllowedValues": [
        "PriceClass_All",
        "PriceClass_200",
        "PriceClass_100"
      ],
      "Default": "PriceClass_All"
    },
    "WafManagedRulesMode": {
      "Type": "String",
      "AllowedValues": [
        "COUNT",
        "BLOCK"
      ],
      "Default": "COUNT"
    }
  },
  "Resources": {
    "WebsiteOac": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-website"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "WebsiteCache": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-WebsiteCache"
          },
          "MinTTL": 0,
          "DefaultTTL": 300,
          "MaxTTL": 604800,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "GameAssetCache": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-GameAssetCache"
          },
          "MinTTL": 0,
          "DefaultTTL": 86400,
          "MaxTTL": 604800,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "whitelist",
              "Headers": [
                "Host"
              ]
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "all"
            }
          }
        }
      }
    },
    "AssetOriginPolicy": {
      "Type": "AWS::CloudFront::OriginRequestPolicy",
      "Properties": {
        "OriginRequestPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-asset-viewer-ip"
          },
          "CookiesConfig": {
            "CookieBehavior": "none"
          },
          "QueryStringsConfig": {
            "QueryStringBehavior": "none"
          },
          "HeadersConfig": {
            "HeaderBehavior": "whitelist",
            "Headers": [
              "X-GTT-Client-IP"
            ]
          }
        }
      }
    },
    "WebsiteFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-WebsiteFunction"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "GTT WebsiteFunction",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": {
          "Fn::Sub": "function handler(event) {\n    var request = event.request;\n    if (request.headers.host.value !== 'www.${DomainName}') {\n        return request;\n    }\n    var parts = [];\n    var query = request.querystring || {};\n    Object.keys(query).forEach(function (key) {\n        var item = query[key];\n        var values = item.multiValue || [item];\n        values.forEach(function (value) {\n            parts.push(key + '=' + value.value);\n        });\n    });\n    var suffix = parts.length ? '?' + parts.join('&') : '';\n    return {\n        statusCode: 308,\n        statusDescription: 'Permanent Redirect',\n        headers: {location: {value: 'https://${DomainName}' + request.uri + suffix}}\n    };\n}\n"
        }
      }
    },
    "ViewerIpFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-ViewerIpFunction"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "GTT ViewerIpFunction",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n    var request = event.request;\n    request.headers['x-gtt-client-ip'] = {value: event.viewer.ip};\n    return request;\n}\n"
      }
    },
    "BusinessWaf": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Scope": "CLOUDFRONT",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "CloudWatchMetricsEnabled": true,
          "MetricName": {
            "Fn::Sub": "${AWS::StackName}-business"
          },
          "SampledRequestsEnabled": false
        },
        "Rules": [
          {
            "Name": "AwsCommon",
            "Priority": 1,
            "OverrideAction": {
              "Fn::If": [
                "ObserveWaf",
                {
                  "Count": {}
                },
                {
                  "None": {}
                }
              ]
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesCommonRuleSet"
              }
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": {
                "Fn::Sub": "${AWS::StackName}-common"
              },
              "SampledRequestsEnabled": false
            }
          }
        ]
      }
    },
    "WebsiteDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "IPV6Enabled": false,
          "HttpVersion": "http2and3",
          "PriceClass": {
            "Ref": "PriceClass"
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 400,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 405,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 414,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 416,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 501,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ],
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Fn::ImportValue": {
                "Fn::Sub": "${FoundationStackName}-CertificateArn"
              }
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "Comment": "GTT website, private S3 origin",
          "Aliases": [
            {
              "Ref": "DomainName"
            },
            {
              "Fn::Sub": "www.${DomainName}"
            }
          ],
          "DefaultRootObject": "index.html",
          "Origins": [
            {
              "Id": "website",
              "DomainName": {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-WebsiteBucketDomain"
                }
              },
              "OriginAccessControlId": {
                "Ref": "WebsiteOac"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "website",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": {
              "Ref": "WebsiteCache"
            },
            "Compress": true,
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "WebsiteFunction",
                    "FunctionMetadata.FunctionARN"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "BusinessDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "IPV6Enabled": false,
          "HttpVersion": "http2and3",
          "PriceClass": {
            "Ref": "PriceClass"
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 400,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 405,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 414,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 416,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 501,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ],
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Fn::ImportValue": {
                "Fn::Sub": "${FoundationStackName}-CertificateArn"
              }
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "Comment": "GTT business, dynamic requests never cached",
          "Aliases": [
            {
              "Fn::Sub": "play.${DomainName}"
            },
            {
              "Fn::Sub": "api.${DomainName}"
            },
            {
              "Fn::Sub": "merchant.${DomainName}"
            },
            {
              "Fn::Sub": "admin.${DomainName}"
            }
          ],
          "WebACLId": {
            "Fn::GetAtt": [
              "BusinessWaf",
              "Arn"
            ]
          },
          "Origins": [
            {
              "Id": "business",
              "DomainName": {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-AlbDomainName"
                }
              },
              "ConnectionAttempts": 1,
              "ConnectionTimeout": 3,
              "OriginCustomHeaders": [
                {
                  "HeaderName": "X-GTT-Origin-Verify",
                  "HeaderValue": {
                    "Fn::Sub": [
                      "{{resolve:secretsmanager:${SecretArn}:SecretString}}",
                      {
                        "SecretArn": {
                          "Fn::ImportValue": {
                            "Fn::Sub": "${FoundationStackName}-OriginSecretArn"
                          }
                        }
                      }
                    ]
                  }
                }
              ],
              "CustomOriginConfig": {
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ],
                "OriginReadTimeout": 30
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "business",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "PATCH",
              "POST",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "Compress": true,
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "ViewerIpFunction",
                    "FunctionMetadata.FunctionARN"
                  ]
                }
              }
            ],
            "OriginRequestPolicyId": "216adef6-5c7f-47e4-b989-5492eafa07d3"
          },
          "CacheBehaviors": [
            {
              "TargetOriginId": "business",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "GameAssetCache"
              },
              "Compress": true,
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "ViewerIpFunction",
                      "FunctionMetadata.FunctionARN"
                    ]
                  }
                }
              ],
              "OriginRequestPolicyId": {
                "Ref": "AssetOriginPolicy"
              },
              "PathPattern": "/assets/*"
            },
            {
              "TargetOriginId": "business",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "GameAssetCache"
              },
              "Compress": true,
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "ViewerIpFunction",
                      "FunctionMetadata.FunctionARN"
                    ]
                  }
                }
              ],
              "OriginRequestPolicyId": {
                "Ref": "AssetOriginPolicy"
              },
              "PathPattern": "/shared/*"
            }
          ]
        }
      }
    },
    "WebsiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-WebsiteBucketName"
          }
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::ImportValue": {
                    "Fn::Sub": "${FoundationStackName}-WebsiteBucketArn"
                  }
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "${FoundationStackName}-WebsiteBucketArn"
                        }
                      },
                      "/*"
                    ]
                  ]
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "AllowWebsiteDistributionOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "${FoundationStackName}-WebsiteBucketArn"
                      }
                    },
                    "/*"
                  ]
                ]
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${WebsiteDistribution}"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "WebsiteDistributionId": {
      "Value": {
        "Ref": "WebsiteDistribution"
      }
    },
    "WebsiteDistributionDomain": {
      "Value": {
        "Fn::GetAtt": [
          "WebsiteDistribution",
          "DomainName"
        ]
      }
    },
    "BusinessDistributionId": {
      "Value": {
        "Ref": "BusinessDistribution"
      }
    },
    "BusinessDistributionDomain": {
      "Value": {
        "Fn::GetAtt": [
          "BusinessDistribution",
          "DomainName"
        ]
      }
    },
    "BusinessWafArn": {
      "Value": {
        "Fn::GetAtt": [
          "BusinessWaf",
          "Arn"
        ]
      }
    }
  },
  "Conditions": {
    "ObserveWaf": {
      "Fn::Equals": [
        {
          "Ref": "WafManagedRulesMode"
        },
        "COUNT"
      ]
    }
  }
}
