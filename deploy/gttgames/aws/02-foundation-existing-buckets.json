{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "GTT existing-EC2 foundation using two verified existing private S3 buckets. Does not create buckets or manage their configuration. No EC2 replacement.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "AlbSubnetA": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "AlbSubnetB": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "InstanceId": {
      "Type": "AWS::EC2::Instance::Id"
    },
    "InstanceSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:acm:us-east-1:[0-9]{12}:certificate/[a-f0-9-]+"
    },
    "CloudFrontPrefixListId": {
      "Type": "String",
      "AllowedPattern": "pl-[a-f0-9]+",
      "Description": "us-east-1 AWS managed com.amazonaws.global.cloudfront.origin-facing prefix list."
    },
    "DomainName": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]+\\.[a-z]{2,}",
      "Default": "gttgames.com"
    },
    "NotificationEmail": {
      "Type": "String",
      "Description": "Optional alarm email; SNS confirmation is required.",
      "Default": ""
    },
    "EnableBackupMonitoring": {
      "Type": "String",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Enable only after a daily consistent backup job has been installed and tested.",
      "Default": "false"
    },
    "ExistingWebsiteBucketName": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]",
      "Description": "Same-account us-east-1 private bucket, verified with recovery_preflight.py before deployment."
    },
    "ExistingBackupBucketName": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]",
      "Description": "Same-account us-east-1 private bucket, verified with recovery_preflight.py before deployment."
    }
  },
  "Resources": {
    "BackupBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ExistingBackupBucketName"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${ExistingBackupBucketName}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${ExistingBackupBucketName}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "OriginSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "GTT CloudFront to ALB origin verification. Never put its plaintext in source or outputs.",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "GTT"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AppLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/gtt/${AWS::StackName}/application"
        },
        "RetentionInDays": 14
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AlarmTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {}
    },
    "AlarmEmail": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "Protocol": "email",
        "Endpoint": {
          "Ref": "NotificationEmail"
        },
        "TopicArn": {
          "Ref": "AlarmTopic"
        }
      },
      "Condition": "HasEmail"
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "GttBackupAndTelemetry",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject",
                    "s3:AbortMultipartUpload"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ExistingBackupBucketName}/backups/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ExistingBackupBucketName}/releases/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ExistingBackupBucketName}"
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "backups/*",
                        "releases/*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents",
                    "logs:DescribeLogStreams"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "AppLogGroup",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudwatch:PutMetricData",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "cloudwatch:namespace": [
                        "GTT.Instance",
                        "GTT.Backup"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/gtt/${AWS::StackName}/cloudwatch-agent"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "GTT"
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "AgentConfig": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": {
          "Fn::Sub": "/gtt/${AWS::StackName}/cloudwatch-agent"
        },
        "Type": "String",
        "Value": {
          "Fn::Sub": "{\"agent\":{\"metrics_collection_interval\":60},\"metrics\":{\"namespace\":\"GTT.Instance\",\"append_dimensions\":{\"InstanceId\":\"${!aws:InstanceId}\"},\"aggregation_dimensions\":[[\"InstanceId\"]],\"metrics_collected\":{\"mem\":{\"measurement\":[\"mem_used_percent\"]},\"disk\":{\"measurement\":[\"used_percent\"],\"resources\":[\"/\"],\"drop_device\":true},\"procstat\":[{\"pattern\":\"py\\\\.merchant\\\\.rtp_worker\",\"measurement\":[\"pid_count\"]}]}},\"logs\":{\"logs_collected\":{\"files\":{\"collect_list\":[{\"file_path\":\"/var/log/gtt/gtt-gateway.log\",\"log_group_name\":\"${AppLogGroup}\",\"log_stream_name\":\"{instance_id}/gateway\"},{\"file_path\":\"/var/log/gtt/gtt-admin.log\",\"log_group_name\":\"${AppLogGroup}\",\"log_stream_name\":\"{instance_id}/admin\"},{\"file_path\":\"/www/wwwlogs/gtt-alb-access.log\",\"log_group_name\":\"${AppLogGroup}\",\"log_stream_name\":\"{instance_id}/nginx\"}]}}}}"
        },
        "Description": "Non-secret CloudWatch agent configuration. Install/start the agent separately."
      }
    },
    "AlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "GTT ALB HTTPS only from CloudFront",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixListId"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8081,
            "DestinationSecurityGroupId": {
              "Ref": "InstanceSecurityGroupId"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "GTT"
          }
        ]
      }
    },
    "GatewayIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "InstanceSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurityGroup"
        },
        "Description": "GTT internal Nginx from managed ALB only"
      }
    },
    "ConsoleIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "InstanceSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "FromPort": 8081,
        "ToPort": 8081,
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurityGroup"
        },
        "Description": "GTT internal Nginx from managed ALB only"
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "IpAddressType": "ipv4",
        "Subnets": [
          {
            "Ref": "AlbSubnetA"
          },
          {
            "Ref": "AlbSubnetB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.preserve_host_header.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "60"
          },
          {
            "Key": "access_logs.s3.enabled",
            "Value": "false"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "GTT"
          }
        ]
      }
    },
    "GatewayTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "TargetType": "instance",
        "Protocol": "HTTP",
        "Port": 8080,
        "Targets": [
          {
            "Id": {
              "Ref": "InstanceId"
            },
            "Port": 8080
          }
        ],
        "HealthCheckProtocol": "HTTP",
        "HealthCheckPort": "traffic-port",
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 2,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "60"
          }
        ]
      }
    },
    "ConsoleTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "TargetType": "instance",
        "Protocol": "HTTP",
        "Port": 8081,
        "Targets": [
          {
            "Id": {
              "Ref": "InstanceId"
            },
            "Port": 8081
          }
        ],
        "HealthCheckProtocol": "HTTP",
        "HealthCheckPort": "traffic-port",
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 2,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "60"
          }
        ]
      }
    },
    "HttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "ContentType": "text/plain",
              "MessageBody": "Forbidden",
              "StatusCode": "403"
            }
          }
        ]
      }
    },
    "GatewayRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 10,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                {
                  "Fn::Sub": "api.${DomainName}"
                },
                {
                  "Fn::Sub": "play.${DomainName}"
                }
              ]
            }
          },
          {
            "Field": "http-header",
            "HttpHeaderConfig": {
              "HttpHeaderName": "X-GTT-Origin-Verify",
              "Values": [
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${OriginSecret}:SecretString}}"
                }
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "GatewayTargetGroup"
            }
          }
        ]
      }
    },
    "ConsoleRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 20,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                {
                  "Fn::Sub": "merchant.${DomainName}"
                },
                {
                  "Fn::Sub": "admin.${DomainName}"
                }
              ]
            }
          },
          {
            "Field": "http-header",
            "HttpHeaderConfig": {
              "HttpHeaderName": "X-GTT-Origin-Verify",
              "Values": [
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${OriginSecret}:SecretString}}"
                }
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "ConsoleTargetGroup"
            }
          }
        ]
      }
    },
    "InstanceStatusAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/EC2",
        "MetricName": "StatusCheckFailed",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "CpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/EC2",
        "MetricName": "CPUUtilization",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Threshold": 85,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "MemoryAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "GTT.Instance",
        "MetricName": "mem_used_percent",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Threshold": 85,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "DiskAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "GTT.Instance",
        "MetricName": "disk_used_percent",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "RtpProcessAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "GTT.Instance",
        "MetricName": "procstat_lookup_pid_count",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "Statistic": "Minimum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "BackupAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "GTT.Backup",
        "MetricName": "BackupSuccess",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "Statistic": "Minimum",
        "Period": 86400,
        "EvaluationPeriods": 1,
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      },
      "Condition": "MonitorBackup"
    },
    "GatewayTargetGroupHealthAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "UnHealthyHostCount",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": [
                "LoadBalancer",
                "LoadBalancerFullName"
              ]
            }
          },
          {
            "Name": "TargetGroup",
            "Value": {
              "Fn::GetAtt": [
                "GatewayTargetGroup",
                "TargetGroupFullName"
              ]
            }
          }
        ],
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "ConsoleTargetGroupHealthAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "UnHealthyHostCount",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": [
                "LoadBalancer",
                "LoadBalancerFullName"
              ]
            }
          },
          {
            "Name": "TargetGroup",
            "Value": {
              "Fn::GetAtt": [
                "ConsoleTargetGroup",
                "TargetGroupFullName"
              ]
            }
          }
        ],
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "AlbServerErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "HTTPCode_ELB_5XX_Count",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": [
                "LoadBalancer",
                "LoadBalancerFullName"
              ]
            }
          }
        ],
        "Threshold": 5,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    }
  },
  "Outputs": {
    "CertificateArn": {
      "Value": {
        "Ref": "CertificateArn"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-CertificateArn"
        }
      }
    },
    "DomainName": {
      "Value": {
        "Ref": "DomainName"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-DomainName"
        }
      }
    },
    "WebsiteBucketName": {
      "Value": {
        "Ref": "ExistingWebsiteBucketName"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-WebsiteBucketName"
        }
      }
    },
    "WebsiteBucketArn": {
      "Value": {
        "Fn::Sub": "arn:${AWS::Partition}:s3:::${ExistingWebsiteBucketName}"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-WebsiteBucketArn"
        }
      }
    },
    "WebsiteBucketDomain": {
      "Value": {
        "Fn::Sub": "${ExistingWebsiteBucketName}.s3.${AWS::Region}.${AWS::URLSuffix}"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-WebsiteBucketDomain"
        }
      }
    },
    "BackupBucketName": {
      "Value": {
        "Ref": "ExistingBackupBucketName"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-BackupBucketName"
        }
      }
    },
    "OriginSecretArn": {
      "Value": {
        "Ref": "OriginSecret"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-OriginSecretArn"
        }
      }
    },
    "AlbDomainName": {
      "Value": {
